# MongoDB Atlas connection string for production, or local Docker service.
MONGODB_URI=mongodb://aiverse:replace-this-password@127.0.0.1:27017/aiverse?authSource=admin

# Set to your deployed Vercel origin in Render (no trailing slash).
WEB_ORIGIN=http://localhost:5173

# Configure these on the backend only. Keep the key out of Vercel and source control.
AI_ALLOW_NETWORK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mercado Pago Colombia subscriptions (backend only). Keep the access token private.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PRICE_STARTER_COP=3300
MP_PRICE_PLUS_COP=26500
MP_PRICE_PRO_COP=59600

# Used only when building the web Docker image locally. On Vercel set VITE_API_URL.
VITE_API_URL=http://localhost:4179

# Use the final public site origin here when building the web app; it is written into robots.txt and sitemap.xml.
VITE_SITE_URL=https://aiverse.vercel.app

# Production defaults to disabling the shared local-repository and remote-sync API.
# Only enable it for a trusted single-tenant installation.
ENABLE_SHARED_REPOSITORY_API=false

# Used by docker-compose for the local MongoDB container.
MONGO_PASSWORD=replace-with-a-long-random-password
