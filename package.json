{
  "name": "aiverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @aiverse/core && npm run build -w @aiverse/cli && npm run build -w @aiverse/server && npm run build -w @aiverse/web",
    "test": "vitest run --exclude '**/aiverse/**'",
    "bench": "tsx benchmarks/run.ts",
    "dev:server": "npm run dev -w @aiverse/server",
    "dev:web": "npm run dev -w @aiverse/web"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0"
  }
}
