{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @aiverse/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/explore", "destination": "/" },
    { "source": "/docs", "destination": "/" },
    { "source": "/workspace", "destination": "/" },
    { "source": "/login", "destination": "/" },
    { "source": "/signup", "destination": "/" },
    { "source": "/account", "destination": "/" },
    { "source": "/settings", "destination": "/" },
    { "source": "/pull-requests", "destination": "/" },
    { "source": "/pricing", "destination": "/" },
    { "source": "/terms", "destination": "/" },
    { "source": "/privacy", "destination": "/" },
    { "source": "/aviso-legal", "destination": "/" },
    { "source": "/cookies", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
