# Rename to .env on the Lightsail instance. Never commit the real .env file.
AIVERSE_DOMAIN=aiverse.example.com

# Atlas: Database > Clusters > Connect > Drivers. URL-encode special characters
# in the database user's password before putting it in the URI.
MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/aiverse?retryWrites=true&w=majority

# Optional; leave disabled until a Gemini API key is configured.
AI_ALLOW_NETWORK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Keep disabled on public deployments until the shared repository API is isolated per account.
ENABLE_SHARED_REPOSITORY_API=false
